# Normalize line endings: store everything as LF in the repo, and let Git
# convert on checkout per-platform. Stops the "LF will be replaced by CRLF"
# warnings on Windows.
* text=auto eol=lf

# Explicit LF for source/config/text (belt-and-suspenders).
*.py    text eol=lf
*.toml  text eol=lf
*.txt   text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.env   text eol=lf
Dockerfile      text eol=lf
.dockerignore   text eol=lf
.gitignore      text eol=lf

# Windows-only scripts keep CRLF.
*.bat   text eol=crlf

# Binary — never touch line endings.
*.db    binary
*.png   binary
*.jpg   binary
*.ico   binary
